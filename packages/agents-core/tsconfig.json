{
  "extends": "@workspace/typescript-config/base.json",
  "compilerOptions": {
    "lib": ["es2023"],
    "outDir": "./dist",
    "rootDir": "./src",
    "types": ["node"]
  },
  "include": ["src"],
  // Tests never reach `dist/` — see `tsconfig.test.json`, which typechecks them.
  "exclude": ["node_modules", "dist", "src/**/*.test.ts"]
}
