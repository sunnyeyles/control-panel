{
  "name": "@repo/agents-core",
  "version": "1.0.0",
  "description": "Core logic and utilities for agent-based modules.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "extends": "@repo/typescript-config/base.json",
  "scripts": {
    "build": "tsc -b",
    "clean": "rimraf dist",
