{
  "name": "@workspace/agent-tools",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "description": "Shared tool catalog, grouped by domain. One tool per module, importable individually; there is no barrel.",
  "exports": {
    "./time": {
      "types": "./dist/time.d.ts",
      "default": "./dist/time.js"
    },
    "./web-search": {
      "types": "./dist/web-search.d.ts",
      "default": "./dist/web-search.js"
    },
    "./env": {
      "types": "./dist/env.d.ts",
      "default": "./dist/env.js"
    },
    "./boards/*": {
      "types": "./dist/boards/*.d.ts",
      "default": "./dist/boards/*.js"
    },
    "./whiteboard/*": {
      "types": "./dist/whiteboard/*.d.ts",
      "default": "./dist/whiteboard/*.js"
    },
    "./pages/*": {
      "types": "./dist/pages/*.d.ts",
      "default": "./dist/pages/*.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --build",
    "clean": "rm -rf dist .turbo *.tsbuildinfo",
    "dev": "tsc --build --watch",
    "lint": "eslint",
    "format": "prettier --write \"**/*.ts\"",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "@langchain/core": "^1.2.3",
    "@workspace/whiteboard-schema": "workspace:*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "eslint": "^9",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
