{
  "name": "@workspace/db",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "description": "Postgres for scheduling and provenance — jobs, runs, artifacts. Prisma Client plus domain helpers for claim/schedule invariants.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "prisma"
  ],
  "scripts": {
    "generate": "prisma generate",
    "build": "tsc --build",
    "clean": "rm -rf dist .turbo *.tsbuildinfo src/generated",
    "dev": "tsc --build --watch",
    "lint": "eslint",
    "format": "prisma format && prettier --write \"**/*.ts\" \"prisma.config.ts\"",
    "migrate": "prisma migrate deploy",
    "migrate:dev": "prisma migrate dev",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "cron-parser": "^5.4.0",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "prisma": "^7.9.1",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
