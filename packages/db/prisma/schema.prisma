// Application tables only. Neon Auth lives in `neon_auth` and is never modeled
// here — `users.auth_user_id` is a plain text column on purpose, not an FK.
//
// CHECK constraints that Prisma cannot express live in the migration SQL beside
// this schema. Migrations here are hand-authored and forward-only.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  // Better Auth nanoids — text, not uuid. Nullable so unlinked users remain
  // legal; UNIQUE still maps one auth identity to at most one row.
  authUserId String?  @unique @map("auth_user_id")

  documents Document[]
  board     Board?

  @@map("users")
}

model Document {
  // Supplied by the caller, and deliberately without a `@default`. This uuid is
  // the S3 key segment in `{environment}/{userId}/resumes/{id}{extension}`
  // before it is a primary key, and the object is written before the row — so a
  // default that quietly fired would mint a row addressing nothing.
  id         String   @id @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  // The other half of the key. A CHECK in the migration SQL pins it to the
  // shape `EXTENSION_SOURCE` in `@workspace/user-storage/keys` accepts.
  extension  String
  // What the user called the file. Here rather than in S3 user metadata, which
  // is an HTTP header and so carries printable ASCII and nothing else — an em
  // dash in a filename did not survive that round trip.
  filename   String
  // text + CHECK in migration SQL rather than a Postgres enum. NOT NULL:
  // "unlabelled" was a state for objects written before the label existed, and
  // `other` is the honest value for an upload whose posted label we do not
  // recognise.
  docType    String   @default("other") @map("doc_type")
  byteSize   Int      @map("byte_size")
  uploadedAt DateTime @default(now()) @map("uploaded_at") @db.Timestamptz(6)

  // Restrict: a row is a pointer at bytes in a bucket, so deleting the user out
  // from under it would leave objects nothing names.
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, uploadedAt(sort: Desc), id(sort: Desc)], map: "documents_user_uploaded_idx")
  @@map("documents")
}

model Board {
  userId String @id @map("user_id") @db.Uuid
  // A tldraw store snapshot, opaque here. Nothing in this package reads inside
  // it — its shape is tldraw's, it changes when tldraw's schema does, and tldraw
  // migrates it on load. A column per shape would be a second, worse copy of a
  // format that already has an owner.
  snapshot  Json
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Cascades, unlike `Document`. A board is something the user is working on,
  // not a pointer at anything outside the database, so `Restrict` would make a
  // user undeletable for the sake of a drawing.
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("boards")
}
