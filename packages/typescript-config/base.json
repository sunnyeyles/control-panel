{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Default",
  "compilerOptions": {
    // Relative imports name the file that actually exists — `./schedule.ts`.
    // `rewriteRelativeImportExtensions` (below) turns that into `./schedule.js`
    // on emit and implies this option for resolution, so this line is not what
    // makes `.ts` specifiers legal. It is set explicitly for the one thing the
    // implication does not cover: promoting a type-only import to a value
    // import otherwise rewrites its `.ts` specifier back to `.js`.
    // Full rationale in CLAUDE.md § Conventions.
    "allowImportingTsExtensions": true,
    "declaration": true,
    "declarationMap": true,
    "esModuleInterop": true,
    "incremental": false,
    "isolatedModules": true,
    "lib": ["es2022", "DOM", "DOM.Iterable"],
    "module": "NodeNext",
    "moduleDetection": "force",
    "moduleResolution": "NodeNext",
    "noUncheckedIndexedAccess": true,
    "resolveJsonModule": true,
    // Rewrites relative `.ts` specifiers to `.js` on emit, keeping `dist/`
    // valid Node ESM under NodeNext. See `allowImportingTsExtensions` above.
    "rewriteRelativeImportExtensions": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022"
  }
}
