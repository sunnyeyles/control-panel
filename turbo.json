{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalEnv": [
    "OPENAI_API_KEY",
    "OPENAI_SECRET_ID",
    "DATABASE_URL",
    "DATABASE_URL_UNPOOLED",
    "DATABASE_SECRET_ID",
    "TAVILY_API_KEY",
    "TAVILY_SECRET_ID",
    "USER_STORAGE_BUCKET_NAME",
    "USER_STORAGE_ENVIRONMENT",
    "AWS_REGION",
    "NEON_AUTH_BASE_URL",
    "NEON_AUTH_COOKIE_SECRET",
    "AUTH_ALLOWED_EMAILS"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "format": {
      "dependsOn": ["^format"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "zip": {
      "dependsOn": ["build"],
      "outputs": ["lambda.zip"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    }
  }
}
