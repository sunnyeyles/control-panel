{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalEnv": [
    "OPENAI_API_KEY",
    "OPENAI_SECRET_ID",
    "LANGFUSE_PUBLIC_KEY",
    "LANGFUSE_SECRET_KEY",
    "LANGFUSE_BASE_URL",
    "LANGFUSE_TRACING_ENVIRONMENT",
    "LANGCHAIN_CALLBACKS_BACKGROUND",
    "NEXT_RUNTIME",
    "DATABASE_URL",
    "DATABASE_URL_UNPOOLED",
    "DATABASE_SECRET_ID",
    "TAVILY_API_KEY",
    "APIFY_TOKEN",
    "APIFY_SECRET_ID",
    "USER_STORAGE_BUCKET_NAME",
    "USER_STORAGE_ENVIRONMENT",
    "AWS_REGION",
    "AWS_DEFAULT_REGION",
    "AWS_ROLE_ARN",
    "BRIEFING_WORKER_FUNCTION_NAME",
    "NEON_AUTH_BASE_URL",
    "NEON_AUTH_COOKIE_SECRET",
    "AUTH_ALLOWED_EMAILS",
    "DEV_AUTH_BYPASS",
    "NODE_ENV"
  ],
  "globalPassThroughEnv": ["VERCEL_OIDC_TOKEN", "NO_COLOR"],
  "tasks": {
    "generate": {
      "outputs": ["src/generated/**"]
    },
    "build": {
      "dependsOn": ["^build", "generate"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "format": {
      "dependsOn": ["^format"]
    },
    "typecheck": {
      "dependsOn": ["^build", "generate"]
    },
    "test": {
      "dependsOn": ["^build", "generate"]
    },
    "eval": {
      "dependsOn": ["^build", "generate"],
      // Never cached, and not for the usual reason. A run calls a real model,
      // so its result is different every time even when nothing changed —
      // `OPENAI_API_KEY` is already in `globalEnv`, so a cache hit would skip
      // the run entirely and print yesterday's scores as today's.
      "cache": false,
      // Task-scoped rather than added to `globalEnv`, which would rehash every
      // other task in the repo for variables only this one reads.
      "env": [
        "EVAL_MODEL",
        "EVAL_JUDGE_MODEL",
        "EVAL_REPEATS",
        "EVAL_CASES",
        "EVAL_WRITE_BASELINE"
      ]
    },
    "zip": {
      "dependsOn": ["build"],
      "outputs": ["lambda.zip"]
    },
    "dev": {
      "dependsOn": ["^build", "generate"],
      "cache": false,
      "persistent": true
    }
  }
}
