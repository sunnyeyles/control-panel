# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage

# next.js
.next/
out/

# production
build
dist

# turbo
.turbo

# misc
.DS_Store
*.pem

# claude code (personal, per-machine overrides)
.claude/settings.local.json

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# azure functions local host settings (holds a local OPENAI_API_KEY)
# kept until the azure stack is decommissioned; see infra/README.md
local.settings.json

# azure functions deploy artifact (built from dist/ on demand)
functionapp.zip

# azure developer cli (per-machine environment state, incl. resolved secrets)
.azure/

# lambda deploy artifact (built from dist/ on demand)
lambda.zip

# terraform: provider binaries and modules, per-machine
.terraform/
# state and plans. state holds every attribute terraform has read, plans hold
# resolved variable values — neither belongs in a diff. `.terraform.lock.hcl`
# is deliberately NOT ignored: pinning provider hashes is the point of it.
*.tfstate
*.tfstate.*
*.tfplan
tfplan
# per-machine backend bucket, see infra/aws/bootstrap/README.md
backend.hcl

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# claude code worktrees (scratch checkouts, never part of the repo)
.claude/worktrees/
